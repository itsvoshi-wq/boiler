# --- chain -------------------------------------------------------------------
# Robinhood Chain mainnet. Chain ID 4663. Defaults to the public endpoint, which
# rate limits hard. Point this at a dedicated endpoint before any real traffic.
RPC_URL=https://rpc.mainnet.chain.robinhood.com
NEXT_PUBLIC_RPC_URL=https://rpc.mainnet.chain.robinhood.com

# --- scan window -------------------------------------------------------------
# Blocks land every ~0.1s, and eth_getLogs caps at 10,000 matches per query, so
# these three numbers decide how wide a window BOILER can honestly report.
SCAN_BLOCKS=3000
SCAN_CHUNK_BLOCKS=1000
SCAN_CACHE_MS=20000
SCAN_MAX_POOLS=90

# --- feature flags -----------------------------------------------------------
# Anything whose economics or legal shape is not final ships off.
NEXT_PUBLIC_FLAG_LIVE_EXECUTION=true
NEXT_PUBLIC_FLAG_BOIL_TOKEN=false
NEXT_PUBLIC_FLAG_STAKING=false
NEXT_PUBLIC_FLAG_STAKER_DISTRIBUTION=false
NEXT_PUBLIC_FLAG_BUYBACK=false
NEXT_PUBLIC_FLAG_BROKER_PAYOUTS=false
NEXT_PUBLIC_FLAG_AUTOMATION=false
NEXT_PUBLIC_FLAG_STRATEGY_REPLICATION=false
NEXT_PUBLIC_FLAG_SEEDED_CREATORS=true
NEXT_PUBLIC_FLAG_AUDIO=false

# --- storage -----------------------------------------------------------------
# Optional. Schema in db/schema.sql. Without it BOILER runs on an in-process
# store and says so on The Books.
# DATABASE_URL=postgres://user:pass@host:5432/boiler

# --- site --------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=https://boiler.market
